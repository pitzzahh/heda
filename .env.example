# HEDA sample environment file.
# Copy to `.env` and fill in real values: `cp .env.example .env`
# `.env` is gitignored. Vite loads it for web builds; Tauri desktop
# builds need nothing from it (there are no app secrets anymore:
# every `.heda` file is sealed with its own user password).

# Optional. Base path for production web builds only (see vite.config.ts).
# Leave unset for Tauri desktop builds and local dev.
# BASE_PATH=/heda

# Release-only (CI secrets, never needed for local dev):
# TAURI_SIGNING_PRIVATE_KEY / TAURI_SIGNING_PRIVATE_KEY_PASSWORD (updater signing)
# ANDROID_RELEASE_KEYSTORE / ANDROID_RELEASE_PASSWORD / ANDROID_RELEASE_KEY /
# ANDROID_RELEASE_KEY_PASSWORD (Android APK signing)
