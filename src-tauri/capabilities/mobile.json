{
	"$schema": "../gen/schemas/mobile-schema.json",
	"identifier": "mobile",
	"description": "enables the mobile runtime permissions",
	"windows": ["main"],
	"platforms": ["android", "iOS"],
	"permissions": [
		"core:default",
		"log:default",
		"dialog:default",
		"stronghold:default",
		"fs:allow-exists",
		"fs:allow-read-dir",
		"fs:allow-rename",
		"fs:allow-remove",
		"fs:write-files",
		"fs:read-files",
		{
			"identifier": "fs:scope",
			"allow": ["$APPLOCALDATA/*"]
		}
	]
}
