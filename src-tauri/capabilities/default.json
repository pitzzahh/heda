{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "enables the default permissions",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"log:default",
		"process:default",
		"core:window:allow-start-dragging",
		"core:window:allow-set-fullscreen",
		"updater:default",
		"fs:allow-rename",
		"fs:allow-remove",
		"stronghold:default",
		"fs:allow-exists",
		"fs:allow-read-dir",
		"fs:write-files",
		"fs:read-files",
		{
			"identifier": "fs:scope",
			"allow": ["$APPLOCALDATA/*"]
		},
		"dialog:default"
	],
	"platforms": ["macOS", "windows", "linux"]
}
